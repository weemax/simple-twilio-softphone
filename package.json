{
  "name": "operator",
  "description": "A Twilio-powered desktop soft phone for developers.",
  "version": "0.0.1",
  "private": false,
  "main": "main.js",
  "homepage": "./",
  "dependencies": {
    "@twilio/voice-sdk": "^2.18.3",
    "electron-is-dev": "^1.1.0"
  },
  "scripts": {
    "phone": "node launcher/phone.js",
    "start": "electron .",
    "dev": "BROWSER=none react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "token-server": "node server/server.js",
    "dev:all": "concurrently -k -n token,web -c blue,green \"npm:token-server\" \"npm:dev\""
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@electron/devtron": "^2.1.1",
    "concurrently": "^9.2.1",
    "electron": "^24.8.8",
    "electron-devtools-installer": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-scripts": "^5.0.1"
  }
}
