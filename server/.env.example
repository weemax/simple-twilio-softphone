# Copy to .env and fill in. NEVER commit .env.
# Real credentials only ever belong in .env, NEVER in .env.example or anywhere
# in version control.

PORT=5050
HOST=127.0.0.1

# Get these from https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=your_api_secret_here
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Verified Twilio phone number used as the outbound caller ID for Client-
# originated calls. Without this, outbound calls hang up with 31005.
# Pick a number from: console.twilio.com → Phone Numbers → Manage → Active Numbers
TWILIO_CALLER_ID=+1xxxxxxxxxx

# Optional: dedicated number for outbound SMS. If unset, falls back to
# TWILIO_CALLER_ID. Set this if your voice and SMS numbers differ (common
# for A2P 10DLC compliance where SMS is a separate long-code or short code).
# TWILIO_SMS_FROM=+1xxxxxxxxxx

# Optional: where Twilio should POST delivery status updates for outbound
# messages. When set, the server registers this URL as the per-message
# statusCallback on every messages.create() call, and your messages' status
# badges will update from 'queued' to 'sent' to 'delivered' (or 'failed').
# In dev: your ngrok URL + /sms/status. In prod: a stable public URL.
# SMS_STATUS_CALLBACK_URL=https://YOUR-DOMAIN.ngrok-free.app/sms/status

# Optional: alternative to SMS_STATUS_CALLBACK_URL. If set, the server
# derives <base>/sms/status automatically. Use one or the other.
# SMS_PUBLIC_BASE_URL=https://YOUR-DOMAIN.ngrok-free.app
