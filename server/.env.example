# Normally the in-app setup (Settings → Twilio account) writes this file for you.
# To fill it in by hand: copy to .env. NEVER commit .env.
# Real credentials only ever belong in .env, NEVER in .env.example or anywhere
# in version control.

PORT=5050
HOST=127.0.0.1

# Get these from https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=your_api_secret_here
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Verified Twilio phone number used as the outbound caller ID for Client-
# originated calls. Without this, outbound calls hang up with 31005.
# Pick a number from: console.twilio.com → Phone Numbers → Manage → Active Numbers
TWILIO_CALLER_ID=+1xxxxxxxxxx

# The Twilio Client identity that inbound voice calls should ring. Must match
# the "Client Identity" entered in the app's Configure form. Required for
# inbound calls; without it, /twiml falls back to a generic message and
# Twilio hangs up.
# OPERATOR_IDENTITY=operator-username

# Required for Twilio's webhooks (inbound calls, inbound SMS, delivery
# updates). Twilio signs every webhook request with your account's primary
# Auth Token (console.twilio.com → Account → API keys & tokens), and the
# server refuses any request whose signature does not match. Without both
# of these, every webhook is refused.
TWILIO_AUTH_TOKEN=your_auth_token_here
# The public address Twilio calls (your tunnel), with no path. Signatures
# are checked against this exact URL, and the SMS status callback defaults
# to <base>/sms/status. Use the same https URL in the Twilio console.
PUBLIC_BASE_URL=https://YOUR-DOMAIN.ngrok-free.app

# Optional: dedicated number for outbound SMS. If unset, falls back to
# TWILIO_CALLER_ID. Set this if your voice and SMS numbers differ (common
# for A2P 10DLC compliance where SMS is a separate long-code or short code).
# TWILIO_SMS_FROM=+1xxxxxxxxxx

# Optional: override where Twilio should POST delivery status updates for
# outbound messages. The server registers this URL (default
# PUBLIC_BASE_URL/sms/status) as the per-message statusCallback on every
# messages.create() call, and your messages' status badges update from
# 'queued' to 'sent' to 'delivered' (or 'failed'). It must still be
# PUBLIC_BASE_URL/sms/status or the updates fail the signature check, so
# leaving it unset is simplest.
# SMS_STATUS_CALLBACK_URL=https://YOUR-DOMAIN.ngrok-free.app/sms/status

# SMS_PUBLIC_BASE_URL is the older name for PUBLIC_BASE_URL and still works.

# Optional, for npm run phone: your ngrok dev domain (ngrok dashboard →
# Gateway → Domains), so ngrok keeps the same address each launch. It must
# match PUBLIC_BASE_URL above when both are set; the launch refuses otherwise.
# NGROK_URL=https://YOUR-DOMAIN.ngrok-free.app

# Optional: where the server writes its per-start local API key (default
# server/.local-api-key). The Electron main process reads the same file to
# call /token and /sms/*; if you change it, set the same path for the app.
# OPERATOR_LOCAL_API_KEY_FILE=/path/to/.local-api-key

# Written by the in-app setup; leave alone. Names the API key and TwiML App
# Operator created, so it only ever changes its own.
# OPERATOR_INSTALL_ID=0123abcd
